# 複製成 .env.local 並填入自己的 Firebase 專案設定（.env.local 不會被提交）。
# 開源自架者：請務必換成「你自己的」Firebase 專案，不要連原作者的資料庫。
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://your-project.firebaseio.com"
VITE_FIREBASE_PROJECT_ID="your-project"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"

# 資料環境命名空間（正式 / 測試隔離）。
# RTDB 所有資料會掛在 envs/<VITE_DB_ENV>/ 底下。
#   本機 .env.local          → "dev"
#   Cloudflare Pages（正式） → "prod"
# 未設定時預設為 "prod"。
VITE_DB_ENV="dev"

# App Check 用的 reCAPTCHA v3 網站金鑰（公開值，可進 bundle）。
# 留空 = 不啟用 App Check（自架者若沒設定就照舊運作）。
VITE_RECAPTCHA_SITE_KEY=""

# 本機 App Check debug token（固定值，只在 DEV 生效）。自己產生一組 UUID，
# 填在這裡，並貼進 Firebase Console → App Check → Manage debug tokens。留空則由 SDK 隨機產生。
VITE_APPCHECK_DEBUG_TOKEN=""
