{
  "rules": {
    "envs": {
      "$env": {
        "rooms": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$roomId": {
            "messages": {
              "$channel": {
                "$msgId": {
                  ".validate": "newData.hasChildren(['senderUid', 'text', 'timestamp']) && newData.child('text').isString() && newData.child('text').val().length <= 2000 && (newData.child('senderUid').val() === auth.uid || newData.child('senderUid').val() === 'system')"
                }
              }
            }
          }
        }
      }
    }
  }
}
